# ── Runtime ────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Interface and port the API listens on.
API_HOST=0.0.0.0
API_PORT=3000
# Pino log level. Logs never contain request bodies, query strings or patient data.
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
# Connection the API uses at runtime. Must be the least-privileged `clinic_app` role so that
# Postgres row-level security applies (never a superuser or the table owner).
DATABASE_URL=postgres://clinic_app:clinic_app@localhost:5432/clinic
# Owner connection used only for migrations, seeding and `clinic:create`.
MIGRATION_DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic

# ── Web / cookies ──────────────────────────────────────────────────────────
# Origin of the staff web app; the only origin allowed by CORS and the CSRF origin check.
WEB_ORIGIN=http://localhost:5173
# Public base URL used in links sent to patients (booking, cancel, Rx share).
PUBLIC_APP_URL=http://localhost:5173
# Send cookies with the Secure flag and the __Host- prefix. Must be true in production.
COOKIE_SECURE=false
# Trust X-Forwarded-* headers (set true behind a reverse proxy / load balancer).
TRUST_PROXY=false

# ── Auth ───────────────────────────────────────────────────────────────────
# Sessions expire after this many idle minutes.
SESSION_IDLE_MINUTES=720
# Failed sign-ins before the account is locked, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Sign-in attempts allowed per IP per minute.
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ── Tests ──────────────────────────────────────────────────────────────────
# Integration tests migrate and use this separate database (created by infra/postgres/init.sql).
TEST_DATABASE_URL=postgres://clinic_app:clinic_app@localhost:5432/clinic_test
TEST_MIGRATION_DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic_test
