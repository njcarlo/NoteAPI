# ── Runtime ────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Interface and port the API listens on.
API_HOST=0.0.0.0
API_PORT=3000
# Pino log level. Logs never contain request bodies, query strings or patient data.
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
# Connection the API uses at runtime. Must be the least-privileged `clinic_app` role so that
# Postgres row-level security applies (never a superuser or the table owner).
DATABASE_URL=postgres://clinic_app:clinic_app@localhost:5432/clinic
# Owner connection used only for migrations, seeding and `clinic:create`.
MIGRATION_DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic

# ── Web / cookies ──────────────────────────────────────────────────────────
# Origin of the staff web app; the only origin allowed by CORS and the CSRF origin check.
WEB_ORIGIN=http://localhost:5173
# Public base URL used in links sent to patients (booking, cancel, Rx share).
PUBLIC_APP_URL=http://localhost:5173
# Send cookies with the Secure flag and the __Host- prefix. Must be true in production.
COOKIE_SECURE=false
# Trust X-Forwarded-* headers (set true behind a reverse proxy / load balancer).
TRUST_PROXY=false

# ── Auth ───────────────────────────────────────────────────────────────────
# Sessions expire after this many idle minutes.
SESSION_IDLE_MINUTES=720
# Session cookie name. Leave unset locally ("sid"; "__Host-sid" when COOKIE_SECURE=true).
# Behind Firebase Hosting set it to __session: Hosting forwards no other cookie to Cloud Run.
# SESSION_COOKIE_NAME=__session
# Live-update (SSE) streams reconnect after this many seconds. Use 55 behind Firebase Hosting.
SSE_MAX_STREAM_SECONDS=1800
# Online booking only offers slots at least this many minutes ahead.
PUBLIC_BOOKING_LEAD_MINUTES=60
# Failed sign-ins before the account is locked, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Sign-in attempts allowed per IP per minute.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Public bookings and cancellations allowed per IP per minute.
PUBLIC_WRITE_RATE_LIMIT_PER_MINUTE=5

# ── Tests ──────────────────────────────────────────────────────────────────
# Integration tests migrate and use this separate database (created by infra/postgres/init.sql).
TEST_DATABASE_URL=postgres://clinic_app:clinic_app@localhost:5432/clinic_test
TEST_MIGRATION_DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic_test

# ── File storage (logos, signatures, prescription PDFs) ────────────────────
# Files are never served from public URLs; the API streams them after checking access.
# local (disk, development) | gcs (Google Cloud Storage, production)
STORAGE_DRIVER=local
# Private bucket for STORAGE_DRIVER=gcs. Credentials come from the runtime service account.
# GCS_BUCKET=my-clinic-files
# Directory for the local driver, relative to the API's working directory.
STORAGE_DIR=./storage

# ── Links and notifications ────────────────────────────────────────────────
# Secret (32+ characters) that signs cancel and opt-out links. Changing it invalidates links
# already sent. Generate with: openssl rand -base64 48
TOKEN_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
# Worker only: connection for the pg-boss job queue. The role must be able to create and own the
# "pgboss" schema (the owner role is fine). The API itself never touches the queue.
JOBS_DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
# SMS: console (dev, prints to the worker log) | semaphore (Philippine gateway) | memory (tests)
SMS_PROVIDER=console
SEMAPHORE_API_KEY=
# Default sender name (max 11 characters); a clinic's own sender name overrides it.
SMS_SENDER_NAME=CLINIC
# Optional: shared secret the SMS gateway sends in the x-webhook-secret header with inbound
# messages to POST /api/webhooks/sms/inbound ("STOP" opts the number out).
# SMS_WEBHOOK_SECRET=
# Email: smtp (Mailpit in dev) | resend | memory (tests)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Clinic <no-reply@clinic.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# ── End-to-end tests (pnpm test:e2e) ──────────────────────────────────────────
# A separate database (created by infra/postgres/init.sql) that the Playwright run reseeds.
E2E_DATABASE_URL=postgres://clinic_app:clinic_app@localhost:5432/clinic_e2e
E2E_MIGRATION_DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic_e2e
# Optional: use an already-installed Chromium instead of `pnpm exec playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chrome
